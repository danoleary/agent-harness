# Agent harness configuration. Copy to `.env` and fill in.
# `.env` is gitignored — it holds real credentials.

# Host-only Linear key — ticket fetch/claim + filing findings. NEVER enters the sandbox (ADR-0001).
LINEAR_API_KEY=lin_api_...

# Passed into the sandbox via `docker -e` (by name; value read from this process env).
# Claude credential — set exactly ONE of these:
#   ANTHROPIC_API_KEY        a long-lived API key (console.anthropic.com), x-api-key auth.
#   CLAUDE_CODE_OAUTH_TOKEN  a subscription OAuth token (`claude setup-token`), Bearer auth.
# An sk-ant-oat01- token MUST go in CLAUDE_CODE_OAUTH_TOKEN — as ANTHROPIC_API_KEY it is
# sent via x-api-key and rejected as "Invalid API key" (BEH-316).
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Host-only GitHub token — harness's own push + `gh pr create` + the post-PR CI-watch.
# MUST be a classic PAT with `repo` scope, SSO-authorized for Herd-Video-Call-Limited.
# A fine-grained PAT — however scoped — CANNOT read check runs (no "Checks" permission
# exists for fine-grained PATs), so `gh pr checks` 403s and the CI-watch can't observe
# CI. The PR still ships (the watch degrades), but only a classic PAT enables it (BEH-476).
GH_TOKEN=ghp_...

# Absolute path to the herd checkout to bind-mount into every container.
HERD_PATH=/Users/you/Documents/GitHub/herd

# Optional overrides (defaults shown).
# HARNESS_IMAGE=herd-agent-harness:latest
# PNPM_STORE_VOLUME=herd-pnpm-store
# TDD_TIMEOUT_MS=1800000
# TDD_MODEL=claude-opus-4-8   # claude --model for the tdd session; pinned to an exact Opus snapshot, not the floating `opus` alias (BEH-389)
# DEDUP_MODEL=claude-haiku-4-5-20251001   # cheap host-side model for the semantic finding-dedup call when filing (BEH-573); a small model is plenty for a same-class-or-NONE classification. Needs a host-side ANTHROPIC_API_KEY (OAuth-only env leaves dedup at exact-match)
# REVIEW_TIMEOUT_MS=1500000   # wall-clock cap for every review-family session: prep install, review, host-side gate, each CI-fix (default 25m); kept above the 20m idle window so a stalled session is reaped by the idle watchdog before this cap, not at it (BEH-535/538)
# RETROSPECTIVE_TIMEOUT_MS=2700000  # wall-clock cap for the retrospective session (default 45m); deliberately larger than the tdd cap — it parses several large jsonl transcripts and borrowing the 30m tdd cap killed it mid-read (BEH-536)
# SESSION_IDLE_TIMEOUT_MS=1200000  # heartbeat: kill a session whose docker stream is silent this long — catches a stream killed while the host slept (default 20m; keep it above the slowest single silent in-sandbox command, e.g. a long build; 0 disables)

# Post-PR CI watch + auto-fix loop the review tool runs (BEH-414).
# CI_MAX_FIX_ATTEMPTS=2       # diagnose+fix+push cycles against a red CI before giving up (default 2)
# CI_FIX_BUDGET_MS=1800000    # overall wall-clock cap on the watch+fix loop (default 30m)
# CI_POLL_INTERVAL_MS=15000   # how often CI checks are re-polled while pending (default 15s)
# CI_POLL_BUDGET_MS=720000    # cap on a single wait for CI checks to reach a terminal state (default 12m)
# CI_POLL_STALL_MS=240000     # bail when the pending check set stops changing this long — a wedged merge-queue/main-only context (default 4m)

# cmd/loop autonomous daemon knobs (DESIGN.md §cmd/loop config knobs). All optional.
# Invalid values are rejected at load (a positive *_MS where required; ceilings allow 0 = unlimited).
# LOOP_POLL_INTERVAL_MS=60000        # idle re-poll wait on an empty queue (default 60s)
# LOOP_CAP_BACKOFF_MS=2700000        # backoff after a spending-cap abort before re-polling (default 45m; interruptible by STOP)
# LOOP_MAX_CONSECUTIVE_FAILURES=3    # circuit-breaker threshold: consecutive no-PR tickets → trip + wind down (default 3)
# LOOP_MAX_TICKETS=0                 # optional AFK ceiling: stop cleanly after N attempted tickets (default 0 = unlimited)
# LOOP_MAX_RUNTIME_MS=0              # optional AFK ceiling: stop cleanly after T wall-clock (default 0 = unlimited)
# LOOP_DISK_RECLAIM_THRESHOLD_BYTES=8589934592  # soft free-disk floor (bytes) below which the loop prunes merged worktrees between tickets (default 8 GiB; 0 = disabled)
# STOP_FILE=agent-harness/STOP       # STOP sentinel path (default agent-harness/STOP; relative is resolved against HERD_PATH). `touch` it to wind down
