# Agent harness configuration. Copy to `.env` and fill in.
# `.env` is gitignored — it holds real credentials.

# Host-only Linear key — ticket fetch/claim + filing findings. NEVER enters the sandbox (ADR-0001).
LINEAR_API_KEY=lin_api_...

# Passed into the sandbox via `docker -e` (by name; value read from this process env).
# Claude credential — set exactly ONE of these:
#   ANTHROPIC_API_KEY        a long-lived API key (console.anthropic.com), x-api-key auth.
#   CLAUDE_CODE_OAUTH_TOKEN  a subscription OAuth token (`claude setup-token`), Bearer auth.
# An sk-ant-oat01- token MUST go in CLAUDE_CODE_OAUTH_TOKEN — as ANTHROPIC_API_KEY it is
# sent via x-api-key and rejected as "Invalid API key" (BEH-316).
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Host-only GitHub token — harness's own push + `gh pr create` + the post-PR CI-watch.
# MUST be a classic PAT with `repo` scope, SSO-authorized for Herd-Video-Call-Limited.
# A fine-grained PAT — however scoped — CANNOT read check runs (no "Checks" permission
# exists for fine-grained PATs), so `gh pr checks` 403s and the CI-watch can't observe
# CI. The PR still ships (the watch degrades), but only a classic PAT enables it (BEH-476).
GH_TOKEN=ghp_...

# Absolute path to the herd checkout to bind-mount into every container.
HERD_PATH=/Users/you/Documents/GitHub/herd

# Optional overrides (defaults shown).
# HARNESS_IMAGE=herd-agent-harness:latest
# PNPM_STORE_VOLUME=herd-pnpm-store
# TDD_TIMEOUT_MS=1800000
# TDD_MODEL=claude-opus-4-8   # claude --model for the tdd session; pinned to an exact Opus snapshot, not the floating `opus` alias (BEH-389)
# REVIEW_TIMEOUT_MS=900000    # wall-clock cap for the review session (default 15m)

# Post-PR CI watch + auto-fix loop the review tool runs (BEH-414).
# CI_MAX_FIX_ATTEMPTS=2       # diagnose+fix+push cycles against a red CI before giving up (default 2)
# CI_FIX_BUDGET_MS=1800000    # overall wall-clock cap on the watch+fix loop (default 30m)
# CI_POLL_INTERVAL_MS=30000   # how often CI checks are re-polled while pending (default 30s)
# CI_POLL_BUDGET_MS=1200000   # cap on a single wait for CI checks to reach a terminal state (default 20m)
